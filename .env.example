# PostHog analytics (see src/telemetry/ once built — single choke point for all events)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Claude API key for puzzle content generation (src/content/tools/generatePuzzles.ts
# only — a dev-time script, never bundled or shipped). Do NOT prefix with
# VITE_: that prefix is what makes Vite expose a var to client code, and
# this key must never reach the browser bundle. Get one at
# https://platform.claude.com
ANTHROPIC_API_KEY=

# T7b/F29 — where `pnpm dev`'s Vite dev-server proxy (vite.config.ts)
# forwards /api/* to. Read by the Vite *config* itself, not app code, so
# (like ANTHROPIC_API_KEY above) this must NOT carry a VITE_ prefix — it
# must never reach the browser bundle. Defaults to local
# `wrangler dev --env dev` (http://127.0.0.1:8787) when unset. Point it at
# the deployed dev Worker to authenticate a real browser session against
# codoro-api-dev:
# DEV_API_TARGET=https://codoro-api-dev.codoroapp.workers.dev
DEV_API_TARGET=
