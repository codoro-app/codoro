  "snippet": "function leadingPositive(readings) {\n  const kept = [];\n  for (const r of readings) {\n    if (r < 0) break;\n    kept.push(r);\n  }\n  console.log(\"kept:\", kept.join(\",\"));\n  console.log(\"count:\", kept.length);\n}\nleadingPositive([3, 5, -1, 7]);",
