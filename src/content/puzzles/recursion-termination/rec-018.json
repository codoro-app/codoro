  "snippet": "function linkCount(node) {\n  let total = 1;\n  if (node.connected) {\n    for (const child of node.connected) total += linkCount(child);\n  }\n  return total;\n}\nconst net = {\n  name: \"cloud\",\n  connected: [{ name: \"api\", connected: [{ name: \"db\" }] }],\n};\nconsole.log(linkCount(net));",
