  "pattern": "off-by-one",
  "difficulty_rating": 1600,
  "explanation": "chunk slices with `arr.slice(i, i + size + 1)` — one index past the intended boundary — so every chunk (except possibly a short trailing one) actually contains `size + 1` elements and overlaps by one item with the next chunk. For [1..7] with size 3, the loop still advances `i` by `size` (3), so it visits i=0,3,6, but each slice grabs 4 elements: [1,2,3,4], [4,5,6,7], [7]. The reported lengths are [4, 4, 1], not the intended [3, 3, 1] — it looks like ordinary chunking until you notice element 4 and element 7 each appear in two different chunks.",
  "prompt": "chunk is meant to split arr into non-overlapping groups of `size`. Step through describeChunks and predict the chunk lengths it reports.",
  "language": "javascript",
  "snippet": "function chunk(arr, size) {\n  const chunks = [];\n  for (let i = 0; i < arr.length; i += size) {\n    chunks.push(arr.slice(i, i + size + 1));\n  }\n  return chunks;\n}\nfunction describeChunks(arr, size) {\n  const chunks = chunk(arr, size);\n  return chunks.map(c => c.length);\n}\nconsole.log(describeChunks([1, 2, 3, 4, 5, 6, 7], 3));",
